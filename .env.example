# ─────────────────────────────────────────────────────────────────────
# SarMeme
#
# MAJBURIY O'ZGARUVCHI YO'Q. Hech narsa sozlamasdan ham ishga tushadi:
#   npm run dev   →   http://localhost:3000
#
# Nima berilmagan bo'lsa, o'rniga xavfsiz zaxira ishlatiladi:
#   Supabase yo'q → xotiradagi baza (qayta ishga tushganda tozalanadi)
#   Gemini yo'q   → evristik ballchi (ochiq formula)
#   Telegram yo'q → xabarlar dashboard va logda
#   RPC yo'q      → zanjir tekshiruvi o'tkazib yuboriladi
#
# Nusxa ko'chiring: cp .env.example .env
# ─────────────────────────────────────────────────────────────────────

# ── Namoyish ─────────────────────────────────────────────────────────
# true bo'lsa sun'iy tokenlar yaratiladi va HAQIQIY quvurdan o'tkaziladi
# (haqiqiy filtr, ballchi, risk menejeri, chiqish qoidalari).
# Tizim nima qilishini darrov ko'rish uchun. Ma'lumot HAQIQIY EMAS.
SIMULATE=false

# ── Dashboard ────────────────────────────────────────────────────────
PORT=3000
# Railway'da ochiq URL bo'ladi — bu yerda albatta uzun tasodifiy satr qo'ying.
# Keyin dashboardni shunday oching: https://...railway.app/?token=SIZNING_TOKEN
DASHBOARD_TOKEN=

# ── Rejim ────────────────────────────────────────────────────────────
# paper = virtual savdo (hech qanday tranzaksiya yuborilmaydi)
# live  = hali qo'llab-quvvatlanmaydi, ataylab bloklangan
TRADING_MODE=paper
LOG_LEVEL=info

# ── Supabase (bepul tarif) — ixtiyoriy, lekin doimiy saqlash uchun kerak
# Project Settings → API → service_role kaliti (server-side, maxfiy)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Solana RPC (Helius bepul tarif) — ixtiyoriy ──────────────────────
# Bo'lmasa: mint/freeze authority va xolder tekshiruvi o'tkazib yuboriladi
SOLANA_RPC_URL=
RPC_MAX_RPS=4

# ── Gemini (bepul tarif) — ixtiyoriy ─────────────────────────────────
# https://aistudio.google.com/apikey
# Bo'lmasa: evristik ballchi ishlaydi (narrativni tushunmaydi)
GEMINI_API_KEY=
# Model ID'larini AI Studio'dan tekshiring — ular yangilanib turadi
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_DEEP=gemini-2.5-pro
# Bitta so'rovda nechta token tahlil qilinsin (rate limitni tejaydi)
AI_BATCH_SIZE=15

# ── Telegram — ixtiyoriy ─────────────────────────────────────────────
# @BotFather dan token, @userinfobot dan o'z chat ID'ingiz
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── PumpPortal (kalit kerak emas) ────────────────────────────────────
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data

# ── Filtr chegaralari (deterministik, AI'siz) ────────────────────────
# Snayping QILMAYMIZ: token tug'ilgandan keyin shu oynada ko'riladi
MIN_AGE_MINUTES=5
MAX_AGE_MINUTES=180
MIN_LIQUIDITY_USD=8000
MIN_VOLUME_5M_USD=2000
MIN_HOLDERS=60
MAX_TOP10_PCT=35
MAX_DEV_RUGS=1

# ── Risk (qattiq limitlar — kodda majburlanadi) ──────────────────────
# Bot ixtiyoridagi kapital (SOL). Asosiy koshelyokdan alohida tuting.
BANKROLL_SOL=2
MAX_POSITION_PCT=4
DAILY_LOSS_LIMIT_PCT=10
MAX_OPEN_POSITIONS=5
MAX_TRADES_PER_HOUR=10

# ── Chiqish qoidalari ────────────────────────────────────────────────
STOP_LOSS_PCT=25
TAKE_PROFIT_PCT=60
TRAILING_STOP_PCT=20
MAX_HOLD_MINUTES=240

# ── AI qaroriga chegara ──────────────────────────────────────────────
MIN_AI_SCORE=70

# ── Sikl oraliqlari (ms) — SIMULATE=true bo'lsa avtomatik tezlashadi ──
# TICK_SCREEN_MS=60000
# TICK_AI_MS=900000
# TICK_POSITIONS_MS=30000
